                            "precipitationMm": {
                              "type": [
                                "number",
                                "null"
                              ]
                            },
                            "windKph": {
                              "type": [
                                "number",
                                "null"
                              ],
                              "description": "Sustained wind at 10 m."
                            },
                            "gustKph": {
                              "type": [
                                "number",
                                "null"
                              ]
                            },
                            "cloudCoverPct": {
                              "type": [
                                "number",
                                "null"
