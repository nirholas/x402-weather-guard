                            },
                            "visibilityM": {
                              "type": [
                                "number",
                                "null"
                              ]
                            },
                            "weatherCode": {
                              "type": [
                                "integer",
                                "null"
                              ],
                              "description": "WMO weather code."
                            },
                            "conditions": {
                              "type": "string",
                              "description": "The WMO code in plain English."
                            }
                          }
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "alerts": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "event": {
                            "type": "string"
                          },
                          "severity": {
                            "type": "string",
                            "description": "NWS severity — Extreme, Severe, Moderate, Minor, Unknown."
                          },
                          "urgency": {
                            "type": "string"
